  "dependencies": {
    "@educationagent/dsl": "file:../vendor/educationagent/dsl",
    "@educationagent/editor": "file:../vendor/educationagent/editor",
    "@educationagent/renderer": "file:../vendor/educationagent/renderer",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-h5-audio-player": "^3.10.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
