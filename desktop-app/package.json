{
  "name": "educationagent-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/build-classroom-export.mjs && vite build",
    "build:public": "node ../scripts/build-public-classroom.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
