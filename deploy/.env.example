# 复制为 deploy/.env 并填写；此示例不含任何真实凭据。
DEPLOY_HOST=your-server-ip
DEPLOY_DOMAIN=smartchildcareagent.cn
DEPLOY_PASSWORD=CHANGE_ME

AI_CHAT_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_CHAT_API_KEY=YOUR_API_KEY
AI_CHAT_MODEL=qwen3.8-flash
AI_CHAT_ENABLE_THINKING=false

# 生产数据库由部署流程创建；不复用本机开发密码。
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/educationagent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia%2FShanghai
SPRING_DATASOURCE_USERNAME=educationagent
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=CHANGE_ME

# 可选集成：仅配置需要使用的服务，留空代表未配置。
