# Copy to /etc/educationagent/runtime.env, root:root mode 0600.
# Values use KEY=value format. Do not add export or shell substitutions.
AI_CHAT_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_CHAT_API_KEY=CHANGE_ME
AI_CHAT_MODEL=qwen3.8-flash
AI_CHAT_ENABLE_THINKING=false
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/educationagent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia%2FShanghai
SPRING_DATASOURCE_USERNAME=educationagent
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=CHANGE_ME
CLASSROOM_ENGINE_NODE=/opt/educationagent/runtime/node/bin/node
CLASSROOM_ENGINE_PATH=/opt/educationagent/current/course-engine/dist/worker.js
CLASSROOM_DATA_DIR=/opt/educationagent/shared/data/classroom
BOT_AUTO_START_COUNT=0
MEMORY_CHROMA_ENABLED=false
MEMORY_EMBEDDING_PROVIDER=ollama
# 启用已核验的兼容 embedding 端点时，覆盖地址、模型、密钥并显式请求 1024 维。
# MEMORY_EMBEDDING_PROVIDER=siliconflow
# MEMORY_EMBEDDING_SILICONFLOW_URL=https://example.test/compatible-mode/v1/embeddings
# MEMORY_EMBEDDING_SILICONFLOW_MODEL=qwen3.7-text-embedding-flash
# MEMORY_EMBEDDING_SILICONFLOW_KEY=CHANGE_ME
# MEMORY_EMBEDDING_REQUEST_DIMENSIONS=true
# ASR_SECRET_ID=CHANGE_ME
# ASR_SECRET_KEY=CHANGE_ME
MEMORY_INTEGRATION_ENABLED=false
EDUCATIONAGENT_DOMAIN=smartchildcareagent.cn

# 默认语音：云雅琴；课堂教师与学伴省略独立覆盖时都继承此音色。
TENCENT_TTS_VOICE_TYPE=403005
TENCENT_TTS_SAMPLE_RATE=16000
# CLASSROOM_VOICE_TEACHER_VOICE_TYPE=403005
# CLASSROOM_VOICE_PEER_VOICE_TYPE=403005
