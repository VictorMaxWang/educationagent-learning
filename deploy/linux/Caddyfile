{$EDUCATIONAGENT_DOMAIN:smartchildcareagent.cn} {
	# Public certificates are obtained and renewed through ACME by Caddy.
	route {
		# 公开学习站仍拒绝其他来源的跨站请求，避免旧接口的宽松 CORS 设置扩大开放范围。
		@foreignOrigin {
			header Origin *
			not header Origin https://smartchildcareagent.cn
		}
		respond @foreignOrigin 403
		# 30 MiB 文件的 Base64 JSON约40 MiB；先限制请求体，再进入Java解码与有界缓存。
		@desktopUpload path /api/desktop/file/upload
		@uploadDeclaredTooLarge expression `header({'Content-Length': '*'}) && int({header.Content-Length}) > 42000000`
		route @desktopUpload {
			respond @uploadDeclaredTooLarge "请求内容超过允许大小，请缩小后重试" 413
			request_body {
				max_size 42MB
			}
		}
		# JSON 在进入 Java 解析前设独立预算；multipart 资料仍沿用既有 10MiB 规则。
		@courseImportJson {
			method POST
			path /api/classroom/courses/import
			header_regexp importJsonType Content-Type "(?i)^application/(json|[^;[:space:]]+[+]json)([[:space:]]*;|[[:space:]]*$)"
		}
		@importDeclaredTooLarge expression `header({'Content-Length': '*'}) && int({header.Content-Length}) > 67108864`
		route @courseImportJson {
			respond @importDeclaredTooLarge "请求内容超过允许大小，请缩小后重试" 413
			request_body {
				max_size 67108864
			}
		}
		@sceneRuntimeJson {
			method PUT PATCH
			path_regexp sceneJsonPath ^/api/classroom/courses/[^/]+/(scenes/[^/]+|runtime)/?$
			header_regexp sceneJsonType Content-Type "(?i)^application/(json|[^;[:space:]]+[+]json)([[:space:]]*;|[[:space:]]*$)"
		}
		@sceneDeclaredTooLarge expression `header({'Content-Length': '*'}) && int({header.Content-Length}) > 8388608`
		route @sceneRuntimeJson {
			respond @sceneDeclaredTooLarge "请求内容超过允许大小，请缩小后重试" 413
			request_body {
				max_size 8388608
			}
		}
		@ordinaryPublicJson {
			method POST PUT PATCH DELETE
			path /api/classroom /api/classroom/* /api/desktop/quiz/* /api/desktop/psychology/* /api/desktop/lifesafety/* /api/desktop/sexedu/* /api/maimemo/config /api/maimemo/speech-preset /api/maimemo/grammar-quiz /api/maimemo/speech-evaluate /api/maimemo/speech-dialogue /api/desktop/watermark/add /api/desktop/watermark/remove
			header_regexp ordinaryJsonType Content-Type "(?i)^application/(json|[^;[:space:]]+[+]json)([[:space:]]*;|[[:space:]]*$)"
			expression `!(method('POST') && path('/api/classroom/courses/import')) && !((method('PUT') || method('PATCH')) && path_regexp('^/api/classroom/courses/[^/]+/(scenes/[^/]+|runtime)/?$'))`
		}
		# 已知长度提前拒绝，避免代理上传遇到 MaxBytesReader 错误后把 413 包装成 502。
		# 未知长度/chunked 仍由 request_body 与 Java 的实际字节计数共同保护。
		@ordinaryDeclaredTooLarge expression `header({'Content-Length': '*'}) && int({header.Content-Length}) > 1048576`
		route @ordinaryPublicJson {
			respond @ordinaryDeclaredTooLarge "请求内容超过允许大小，请缩小后重试" 413
			request_body {
				max_size 1048576
			}
		}
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}
		# 旧模块按具体能力恢复；个人知识库、共享生词本和通用工具执行接口继续由本机提供。
		@backend path /api/classroom /api/classroom/* /api/desktop/quiz/* /api/desktop/file/upload /api/desktop/psychology/* /api/desktop/lifesafety/* /api/desktop/sexedu/* /api/maimemo/config /api/maimemo/speech-preset /api/maimemo/grammar-quiz /api/maimemo/speech-evaluate /api/maimemo/speech-dialogue /api/desktop/watermark/add /api/desktop/watermark/remove /actuator/health
		handle @backend {
			# 课程 JSON 可能包含内联字体；压缩仅覆盖课程接口，保留其他流式接口的逐段传输。
			@courseJson path /api/classroom/courses /api/classroom/courses/*
			encode @courseJson zstd gzip
			reverse_proxy 127.0.0.1:8888 {
				# NDJSON/SSE responses must reach the browser as each chunk is produced.
				flush_interval -1
				header_up -Authorization
				header_down -Access-Control-Allow-Origin
				header_down -Access-Control-Allow-Credentials
			}
		}
		@privateApi path /api /api/* /chat /chat/* /actuator /actuator/*
		handle @privateApi {
			respond 404
		}
		handle {
			encode zstd gzip
			root * /opt/educationagent/current/desktop-app/dist
			try_files {path} /index.html
			file_server
		}
	}
}
