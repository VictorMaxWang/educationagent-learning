      "originalBytes": 4545107,
      "locators": [
        {
          "key": "E01_unknown",
          "page": 3,
          "anchor": "supply no negative physical observation",
          "locator": "§III-A，明确有效失败与通信失败",
          "adoption": "检索失败不转成不相关；unknown标签与false分开。"
        },
        {
          "key": "E02_fixed",
          "page": 5,
          "anchor": "Fix the initial public state",
          "locator": "§IV-A，冻结状态、策略、预算与共同比较参考",
          "adoption": "所有排序使用同查询、同候选、共享资源标签与固定配置。"
        },
        {
          "key": "E03_joint",
          "page": 6,
          "anchor": "The joint test retains the common target",
          "locator": "§IV-B，式(14)—(16)、Proposition 2及说明",
          "adoption": "共享资源只允许一个标签；枚举最多12个未知标签的相容赋值，返回检查次数差上下界。"
        },
        {
          "key": "E04_cutoff",
          "page": 7,
          "anchor": "A cutoff preserves unresolved mass",
          "locator": "§IV-C，截止与复用绑定说明",
          "adoption": "超未知数上限返回NOT_COMPUTED，不能输出零区间或把未知当失败。"
        },
        {
          "key": "E05_denominator",
          "page": 11,
          "anchor": "The prespecified 95% interval in Eq. (23) was",
          "locator": "§V，200个预指定worlds全分母与区间解释",
          "adoption": "评测保留无结果与故障行；工程夹具指标不能伪装人评准确率。"
        },
        {
          "key": "E06_net_cost",
          "page": 15,
          "anchor": "joint-specific net benefit",
          "locator": "在线规划四臂开发筛查段",
          "adoption": "分别报告模型/搜索/优化及端到端成本，不凭目标函数改善宣称在线净收益。"
        },
        {
          "key": "E07_accounting",
          "page": 11,
          "anchor": "All 200 prespecified worlds entered the analysis",
          "locator": "§VII-A，完整预指定分母与中断记录",
          "adoption": "预指定评测样本保留无推荐、无结果和运行失败，不能只选成功行报告指标。"
        }
      ]
    },
